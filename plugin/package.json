{
  "name": "dsh-medresearch-model",
  "version": "0.2.4",
  "description": "医学文献与证据工作台的模型接入与工作台入口插件：DSH 会话模型跟随、自定义 OpenAI 兼容 API、宿主凭据存储、项目/窗口初始化与本地文件服务。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src/host",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  }
}
